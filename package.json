{
  "name": "homebridge-ezone",
  "displayName": "Advantage Air e-zone",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Advantage Air e-zone ducted aircon in Apple Home: one aircon tile with heat, cool, fan-only and dry, a one-tap tile per zone and a sleep timer.",
  "author": "brendan779",
  "license": "MIT",
  "homepage": "https://github.com/brendan779/homebridge-ezone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendan779/homebridge-ezone.git"
  },
  "bugs": {
    "url": "https://github.com/brendan779/homebridge-ezone/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "advantage-air",
    "ezone",
    "e-zone",
    "aircon",
    "ducted"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^2.4.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "mock": "node scripts/mock-ezone.ts",
    "dev:mock": "npm run build && node scripts/dev-setup.mjs && homebridge -U .dev/mock -P . --strict-plugin-resolution -D"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "homebridge": "^2.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
